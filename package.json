  "files": ["src", "docs/architecture.md", "docs/testing.md", "docs/tool-summary-spec.md", "docs/bash-card-spec.md", "docs/edit-card-spec.md", "docs/write-card-spec.md", "docs/card-frame-spec.md", "docs/render-cache-spec.md", "docs/footer-spec.md", "docs/terminal-colors-spec.md", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
