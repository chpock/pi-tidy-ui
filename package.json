{
  "name": "pi-tidy-ui",
  "version": "0.0.0",
  "description": "Compact UI for the Pi coding agent: rich tool cards, Rust-powered syntax highlighting, and prompt-cache usage history.",
  "author": {
    "name": "Kostiantyn Kushnir",
    "url": "https://github.com/chpock"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chpock/pi-tidy-ui.git"
  },
  "homepage": "https://github.com/chpock/pi-tidy-ui#readme",
  "bugs": {
    "url": "https://github.com/chpock/pi-tidy-ui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "terminal-ui",
    "tui",
    "tool-cards",
    "syntax-highlighting",
    "aft"
  ],
  "files": [
    "src",
    "docs/README.md",
    "docs/architecture.md",
    "docs/testing.md",
    "docs/performance-testing.md",
    "docs/screenshots.md",
    "docs/releases.md",
    "docs/assets/pi-tidy-ui.png",
    "docs/tool-summary-spec.md",
    "docs/bash-card-spec.md",
    "docs/bash-streaming-contract.md",
    "docs/edit-card-spec.md",
    "docs/write-card-spec.md",
    "docs/card-frame-spec.md",
    "docs/render-cache-spec.md",
    "docs/footer-spec.md",
    "docs/terminal-colors-spec.md",
    "docs/syntax-highlighting-spec.md",
    "docs/debug-logging-spec.md",
    "docs/settings-menu-spec.md",
    "docs/host-integration.md",
    "docs/rendering.md",
    "docs/user-queued-cards.md",
    "docs/editor.md",
    "docs/color-model.md",
    "docs/syntax/providers.md",
    "docs/syntax/requests.md",
    "docs/syntax/work.md",
    "docs/syntax/storage.md",
    "docs/syntax/prepared-cards.md",
    "docs/syntax/shebang-hints.md",
    "docs/syntax/follow-pi.md",
    "docs/occipital/README.md",
    "docs/occipital/runtime.md",
    "docs/occipital/requests-and-resources.md",
    "docs/occipital/source-engine.md",
    "docs/occipital/styles-and-palettes.md",
    "docs/occipital/catalogue.md",
    "docs/occipital/assets.md",
    "docs/occipital/protocol.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/chpock/pi-tidy-ui/main/docs/assets/pi-tidy-ui.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "node scripts/test/run.mjs --suite check",
    "test:prepare": "node scripts/test/prepare.mjs",
    "test": "node scripts/test/run.mjs --suite unit",
    "test:feature": "node scripts/test/feature.mjs",
    "test:perf": "node scripts/test/performance/run.mjs",
    "screenshot": "node scripts/screenshot/run.mjs",
    "test:product": "node scripts/test/run.mjs --suite product",
    "test:group": "node scripts/test/run.mjs --suite groups",
    "test:smoke": "node scripts/test/run.mjs --suite smoke",
    "test:harness": "node scripts/test/run.mjs --suite harness",
    "test:native": "node scripts/test/run.mjs --suite native",
    "test:terminal": "node scripts/test/run.mjs --suite terminal",
    "test:syntax-terminal": "node scripts/test/run.mjs --suite syntax-terminal",
    "test:native-release": "node scripts/test/run.mjs --suite native-release",
    "test:installed-native": "node scripts/test/run.mjs --suite consumer",
    "test:installed-native:published": "node scripts/test/run.mjs --suite published-consumer",
    "test:rust": "node scripts/test/run.mjs --suite rust",
    "test:rust-harness": "node scripts/test/native-harness.mjs",
    "test:rust-check": "node scripts/test/run.mjs --suite rust-check",
    "test:rust-allocator": "node scripts/test/run.mjs --suite rust-allocator"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22.19.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@cortexkit/subc-client": "0.21.1"
  }
}
